# ==============================================================================
# ChronoTrace DFIR Platform — Template Configuration (.env.example)
# Copy this file to .env and configure for your local or production environment.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Database Settings
DATABASE_PATH=chronotrace.db
DATABASE_WAL_MODE=true

# API Server Settings (FastAPI)
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
CORS_ORIGINS=*

# Streamlit Console Settings
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501

# Defense-Grade Authentication & Session Management
JWT_SECRET_KEY=your-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
SESSION_EXPIRE_SECONDS=28800

# Google OAuth2 Authentication Settings (Google Cloud Console Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8501
GOOGLE_AUTH_SCOPE=openid email profile

# Enterprise SSO (SAML 2.0 / OIDC) Settings
SSO_AGENCY_NAME=Enterprise Cyber Defense Taskforce
SSO_DEFAULT_CLEARANCE=L3 Lead Forensic Specialist
